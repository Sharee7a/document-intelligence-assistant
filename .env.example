# Optional OpenAI-compatible chat completion provider. Without this, cited extractive answers are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

DATA_DIR=data
MAX_UPLOAD_MB=40
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
VITE_API_URL=http://localhost:8000

# Optional dense semantic retrieval. Install requirements-dense.txt and allow the model download first.
USE_DENSE_EMBEDDINGS=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INSTALL_DENSE=0
